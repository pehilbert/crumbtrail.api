# Copy to .env and fill in.
PORT=3000
MONGODB_URI=mongodb://localhost:27017/crumbtrail
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Seconds ("3600") or a duration ("15m", "1h", "7d").
JWT_EXPIRES_IN=1h
THROTTLE_ENABLED=true
# Swagger UI at /api/docs and OpenAPI JSON at /api/docs-json. Set to false in production.
SWAGGER_ENABLED=true
OBSERVE_ENABLED=true
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
