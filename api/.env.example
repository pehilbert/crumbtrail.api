# Copy to .env and fill in.
PORT=3000
MONGODB_URI=mongodb://localhost:27017/crumbtrail
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Access token lifetime: seconds ("900") or a duration ("15m", "1h").
JWT_EXPIRES_IN=15m
# Refresh token lifetime (how long an idle session lasts): seconds or "12h", "30d", "2w".
REFRESH_TOKEN_EXPIRES_IN=30d
# Browsers accept Secure cookies on http://localhost; set to false only if yours does not.
REFRESH_COOKIE_SECURE=true
# strict, lax or none. Use none (with Secure) only if the frontend and API are on different sites.
REFRESH_COOKIE_SAME_SITE=strict
# Comma-separated browser origins allowed to call the API (CORS with credentials).
CORS_ORIGINS=http://localhost:4200
THROTTLE_ENABLED=true
# Swagger UI at /api/docs and OpenAPI JSON at /api/docs-json. Set to false in production.
SWAGGER_ENABLED=true
OBSERVE_ENABLED=true
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
